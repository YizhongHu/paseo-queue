#!/usr/bin/env python3
"""Small local-state CLI surface for the Python port.

Queue delivery runs through a detached per-agent dispatcher with the same
state, retry, permission, and failure behavior as the shell implementation.
"""
from __future__ import print_function
import glob
import json
import os
import shutil
import subprocess
import sys
import signal
import time

USAGE = """Usage: paseo-queue <subcommand> [args]

Subcommands:
  add <agent> [text|--file <path>|stdin] [--wait] [--wait-timeout <seconds>]
      [--quiet]
      Enqueue one message in local state.
  ls
      List every known agent's local queue and pending filenames.
  rm <agent> <msg|--all>
      Remove pending messages.
  status
      Show local dispatcher and queue status.
  drain <agent> [--quiet]
      Start delivery for an agent, printing whether a dispatcher was spawned
      or one was already live. Safe to call repeatedly.
  stop <agent> [--quiet]
      SIGTERM the live dispatcher, naming the pid it terminated. Idempotent:
      exits 0 whether or not one was running, so it composes as an
      ensure-stopped step. The receipt distinguishes the two cases. The queue
      itself is left untouched.
  log <agent> [-n N] [-f]
      Show the dispatch log for an agent.
"""

EXIT_USAGE = 1
EXIT_RESOLUTION = 2
EXIT_DAEMON = 3
EXIT_TIMEOUT = 4

LS_JSON_FETCHED = False
LS_JSON_OUT = b""
LS_JSON_RC = 0
LS_JSON_ROWS = []
LAST_RESOLVE_RC = EXIT_RESOLUTION

def die(message, code=EXIT_USAGE):
    sys.stderr.write("paseo-queue: %s\n" % message)
    return code


def queue_home():
    return os.environ.get("PASEO_QUEUE_HOME", os.path.join(os.path.expanduser("~"), ".paseo-queue"))


def is_uuid(value):
    parts = value.split("-")
    return len(value) == 36 and [len(part) for part in parts] == [8, 4, 4, 4, 12]


def fetch_ls_json():
    """Fetch and parse the daemon snapshot once per process."""
    global LS_JSON_FETCHED, LS_JSON_OUT, LS_JSON_RC, LS_JSON_ROWS
    if LS_JSON_FETCHED:
        return LS_JSON_RC
    try:
        process = subprocess.Popen(
            ["paseo", "ls", "--json"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL)
        LS_JSON_OUT, unused_stderr = process.communicate()
        LS_JSON_RC = process.returncode
    except OSError:
        LS_JSON_OUT = b""
        LS_JSON_RC = 1
    LS_JSON_FETCHED = True
    if LS_JSON_RC == 0:
        try:
            data = json.loads(LS_JSON_OUT.decode("utf-8"))
        except (ValueError, UnicodeError):
            data = []
        if isinstance(data, dict):
            data = data.get("agents", [])
        if isinstance(data, list):
            LS_JSON_ROWS = [row for row in data if isinstance(row, dict)]
    return LS_JSON_RC


def snapshot_agents():
    fetch_ls_json()
    return LS_JSON_ROWS



def resolve_agent(query, allow_orphan=True):
    """Resolve an agent by unique id prefix or exact name."""
    global LAST_RESOLVE_RC
    LAST_RESOLVE_RC = EXIT_RESOLUTION
    if fetch_ls_json() != 0:
        LAST_RESOLVE_RC = EXIT_DAEMON
        sys.stderr.write("paseo-queue: paseo ls --json failed (daemon unreachable?)\n")
        return None

    candidates = []
    seen = set()
    for row in snapshot_agents():
        uuid = row.get("id", "")
        name = row.get("name", "")
        if not isinstance(uuid, str):
            continue
        if not isinstance(name, str):
            name = str(name)
        if (query and uuid.startswith(query)) or name == query:
            if uuid not in seen:
                candidates.append((uuid, name))
                seen.add(uuid)

    if len(candidates) == 1:
        LAST_RESOLVE_RC = 0
        # This is a LIVE match, so the name in hand is authoritative. Refresh
        # the display cache that `ls` reads, so a rename converges as soon as
        # anything touches the agent. See refresh_agent_name.
        matched_uuid, matched_name = candidates[0]
        refresh_agent_name(os.path.join(queue_home(), matched_uuid),
                           matched_uuid, matched_name)
        return candidates[0]
    if len(candidates) > 1:
        sys.stderr.write('paseo-queue: ambiguous agent "%s", candidates:\n' % query)
        for uuid, name in candidates:
            sys.stderr.write("  %s (%s)\n" % (uuid, name))
        return None

    home = queue_home()
    if allow_orphan and is_uuid(query) and os.path.isdir(os.path.join(home, query)):
        name = ""
        try:
            with open(os.path.join(home, query, "agent.name"), "r") as stream:
                name = stream.read().rstrip("\n").split(" ", 1)[-1]
        except (IOError, OSError):
            pass
        LAST_RESOLVE_RC = 0
        return query, name

    sys.stderr.write('paseo-queue: no agent matches "%s"\n' % query)
    return None


def ensure_agent_dirs(agent_dir):
    for name in ("pending", "sent", "failed", "tmp"):
        path = os.path.join(agent_dir, name)
        if not os.path.isdir(path):
            os.makedirs(path)


def message_files(path):
    if not os.path.isdir(path):
        return []
    return sorted(glob.glob(os.path.join(path, "*.msg")))


def agent_name(agent_dir):
    try:
        with open(os.path.join(agent_dir, "agent.name"), "r") as stream:
            text = stream.read().rstrip("\n")
        return text.split(" ", 1)[1] if " " in text else ""
    except (IOError, OSError):
        return ""


def write_agent_name(agent_dir, uuid, name):
    with open(os.path.join(agent_dir, "agent.name"), "w") as stream:
        stream.write("%s %s\n" % (uuid[:7], name))


def refresh_agent_name(agent_dir, uuid, name):
    """Update the cached name if it has drifted from the live one.

    agent.name is a display cache. `ls` reads it and deliberately never
    contacts the daemon, so `ls` keeps working during an outage -- it is the
    command you run WHEN things are broken. The cost of that choice is that a
    renamed agent shows a stale name in `ls`, and a stale name does not
    resolve, so `ls` could advertise an identifier the tool then rejects
    (issue #9).

    The fix is to refresh the cache from every command that already holds a
    live name, rather than to make `ls` daemon-dependent. Best effort: a
    failure to write is never worth failing a command over, since the only
    consequence is a display name staying stale a little longer.
    """
    if not name or not os.path.isdir(agent_dir):
        return
    try:
        if agent_name(agent_dir) == name:
            return
        write_agent_name(agent_dir, uuid, name)
    except (IOError, OSError):
        pass


def env_int(name, default):
    try:
        value = int(os.environ.get(name, str(default)))
    except (TypeError, ValueError):
        return default
    return value


def log_line(agent_dir, event, detail=""):
    timestamp = time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime())
    with open(os.path.join(agent_dir, "dispatch.log"), "a") as stream:
        stream.write("%s [%s] %s %s\n" % (timestamp, os.getpid(), event, detail))


def set_state(agent_dir, state):
    state_tmp = os.path.join(agent_dir, "tmp", "state.%d" % os.getpid())
    with open(state_tmp, "w") as stream:
        stream.write("%s\n" % state)
    os.replace(state_tmp, os.path.join(agent_dir, "state"))


def next_msg_name(agent_dir):
    epoch = "%010d" % int(time.time())
    pid = "%07d" % os.getpid()
    sequence = 0
    while sequence < 10000:
        name = "%s-%s-%04d.msg" % (epoch, pid, sequence)
        if not any(os.path.exists(os.path.join(agent_dir, directory, name))
                   for directory in ("pending", "sent", "failed")):
            return name
        sequence += 1
    raise RuntimeError("unable to allocate a unique message filename")


def pending_is_empty(agent_dir):
    return not message_files(os.path.join(agent_dir, "pending"))


def agent_is_known(uuid):
    if fetch_ls_json() != 0:
        # An unreachable daemon is deliberately treated as "known": do not
        # turn a transient outage into orphan cleanup and data loss.
        return True
    return any(row.get("id", "") == uuid for row in snapshot_agents())

def lock_holder_alive(agent_dir):
    """Return whether lock/pid names a live paseo-queue process."""
    lock_dir = os.path.join(agent_dir, "lock")
    if not os.path.isdir(lock_dir):
        return False
    pid_path = os.path.join(lock_dir, "pid")
    if os.path.isfile(pid_path):
        try:
            with open(pid_path, "r") as stream:
                pid_text = stream.read().strip()
            pid = int(pid_text)
        except (IOError, OSError, TypeError, ValueError):
            return False
        try:
            os.kill(pid, 0)
            command = subprocess.check_output(
                ["ps", "-p", str(pid), "-o", "command="],
                stderr=subprocess.DEVNULL)
        except (OSError, subprocess.CalledProcessError):
            return False
        return b"paseo-queue" in command
    try:
        return time.time() - os.path.getmtime(lock_dir) < 5
    except OSError:
        return False


def dp_lock_is_stale(agent_dir):
    return (os.path.isdir(os.path.join(agent_dir, "lock"))
            and not lock_holder_alive(agent_dir))


def break_stale_lock(agent_dir):
    lock_dir = os.path.join(agent_dir, "lock")
    stale_dir = os.path.join(agent_dir, "lock.stale.%d" % os.getpid())
    try:
        os.rename(lock_dir, stale_dir)
    except OSError:
        return
    shutil.rmtree(stale_dir, ignore_errors=True)


def acquire_lock(agent_dir):
    lock_dir = os.path.join(agent_dir, "lock")
    try:
        os.mkdir(lock_dir)
    except OSError:
        if lock_holder_alive(agent_dir):
            return False
        break_stale_lock(agent_dir)
        try:
            os.mkdir(lock_dir)
        except OSError:
            return False
    try:
        with open(os.path.join(lock_dir, "pid"), "w") as stream:
            stream.write("%d\n" % os.getpid())
    except OSError:
        return False
    return True


def release_lock(agent_dir):
    lock_dir = os.path.join(agent_dir, "lock")
    if not os.path.isdir(lock_dir):
        return True
    pid_path = os.path.join(lock_dir, "pid")
    try:
        with open(pid_path, "r") as stream:
            holder = stream.read().strip()
    except (IOError, OSError):
        return False
    if holder != str(os.getpid()):
        return False
    shutil.rmtree(lock_dir, ignore_errors=True)
    return True


def lock_is_stale(agent_dir):
    return dp_lock_is_stale(agent_dir)


def remove_stale_lock(agent_dir):
    if dp_lock_is_stale(agent_dir):
        break_stale_lock(agent_dir)

def queue_dir_is_empty(agent_dir):
    for directory in ("pending", "sent", "failed", "tmp"):
        if message_files(os.path.join(agent_dir, directory)):
            return False
        subdir = os.path.join(agent_dir, directory)
        if os.path.isdir(subdir):
            try:
                if os.listdir(subdir):
                    return False
            except OSError:
                return False
    return not os.path.exists(os.path.join(agent_dir, "lock"))


def wait_for_delivery(agent_dir, filename, timeout, quiet, short_id):
    if timeout is None:
        timeout = env_int("PASEO_QUEUE_WAIT_TIMEOUT", 60)
    elapsed = 0
    while True:
        if os.path.exists(os.path.join(agent_dir, "sent", filename)):
            if not quiet:
                sys.stdout.write("paseo-queue: delivered %s %s\n" % (short_id, filename))
                sys.stdout.flush()
            return 0
        if os.path.exists(os.path.join(agent_dir, "failed", filename)):
            return die("add --wait: message moved to failed/ (%s)" % filename)
        state_path = os.path.join(agent_dir, "state")
        if os.path.isfile(state_path):
            try:
                with open(state_path, "r") as stream:
                    state = stream.read().rstrip("\n")
            except (IOError, OSError):
                state = ""
            if state in ("halted-closed", "halted-failed", "stalled-daemon"):
                return die("add --wait: dispatcher state is %s" % state)
        if timeout >= 0 and elapsed >= timeout:
            return die("add --wait-timeout: %ss elapsed; message still queued" % timeout,
                       EXIT_TIMEOUT)
        time.sleep(1)
        elapsed += 1

def inspect_dispatch(uuid):
    try:
        output = subprocess.check_output(
            ["paseo", "inspect", uuid, "--json"],
            stderr=subprocess.DEVNULL)
        data = json.loads(output.decode("utf-8"))
    except (OSError, subprocess.CalledProcessError, ValueError, UnicodeError):
        return None
    if isinstance(data, list):
        data = data[0] if data else {}
    if not isinstance(data, dict):
        return None
    status = data.get("Status", data.get("status", "unknown"))
    archived = data.get("Archived", data.get("archived", False))
    permissions = data.get("PendingPermissions",
                           data.get("pendingPermissions", []))
    if not isinstance(status, str):
        status = "unknown"
    if not isinstance(permissions, list):
        permissions = []
    return status.lower(), bool(archived), len(permissions)


def backoff_scale():
    value = os.environ.get("PASEO_QUEUE_BACKOFF_SCALE", "1")
    if not value.isdigit():
        return 1
    return int(value)


def scale_backoff(seconds):
    return seconds * backoff_scale()


def sleep_backoff(seconds):
    elapsed = 0
    while elapsed < seconds:
        time.sleep(1)
        elapsed += 1


def daemon_backoff(attempt):
    if attempt == 1:
        return 10
    if attempt == 2:
        return 30
    return 60


def hold_backoff(attempt):
    if attempt == 1:
        return 5
    if attempt == 2:
        return 10
    if attempt == 3:
        return 20
    if attempt == 4:
        return 30
    return 60


def send_backoff(attempt):
    if attempt == 1:
        return 5
    if attempt == 2:
        return 15
    if attempt == 3:
        return 30
    return 60


def write_send_error(agent_dir, filename, send_rc, stderr_path):
    error_path = os.path.join(agent_dir, "failed", filename + ".err")
    try:
        with open(stderr_path, "rb") as stream:
            stderr_tail = stream.read()[-2000:]
        stderr_tail = stderr_tail.decode("utf-8", "replace")
    except (IOError, OSError, UnicodeError):
        stderr_tail = ""
    try:
        with open(error_path, "w") as stream:
            stream.write("timestamp=%s\n" %
                         time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()))
            stream.write("rc=%s\n" % send_rc)
            stream.write("--- stderr (last 2000 bytes) ---\n")
            stream.write(stderr_tail)
    except (IOError, OSError):
        pass

def parse_add(args):
    if not args:
        return None, die("add: usage: paseo-queue add <agent> [text|--file f|stdin] [--wait] [--wait-timeout <s>]")
    agent_query = args[0]
    tokens = list(args[1:])
    text = None
    file_path = None
    wait = False
    timeout = None
    quiet = False
    positional = []
    index = 0
    literal = False
    while index < len(tokens):
        token = tokens[index]
        index += 1
        if literal:
            positional.append(token)
            continue
        if token == "--":
            literal = True
        elif token == "--file":
            if index >= len(tokens):
                return None, die("add: --file requires a path argument")
            file_path = tokens[index]
            index += 1
        elif token == "--wait":
            wait = True
        elif token == "--quiet":
            quiet = True
        elif token == "--wait-timeout":
            if index >= len(tokens):
                return None, die("add: --wait-timeout requires a value in seconds")
            timeout = tokens[index]
            index += 1
            if not timeout.isdigit():
                return None, die("add: --wait-timeout requires a nonnegative integer")
            wait = True
        elif any(char.isspace() for char in token):
            positional.append(token)
        elif token.startswith("-"):
            return None, die("add: unknown option: %s (if this is your message text, pass it after --)" % token)
        else:
            positional.append(token)
    if len(positional) > 1:
        return None, die("add: too many positional arguments (expected at most one message-text argument); quote the message or use --file/stdin")
    if positional:
        text = positional[0]
    if text is not None and file_path is not None:
        return None, die("add: message sources are mutually exclusive (text, --file, stdin)")
    if text is None and file_path is None:
        if sys.stdin.isatty():
            return None, die("add: no message given (pass text, --file <path>, or pipe stdin)")
        return (agent_query, text, file_path, wait, timeout, quiet, True), 0
    return (agent_query, text, file_path, wait, timeout, quiet, False), 0


def spawn_dispatcher(uuid):
    if os.environ.get("PASEO_QUEUE_NO_SPAWN") == "1":
        return
    agent_dir = os.path.join(queue_home(), uuid)
    log_path = os.path.join(agent_dir, "dispatch.log")
    try:
        log = open(log_path, "ab", 0)
    except OSError:
        log = subprocess.DEVNULL
    try:
        subprocess.Popen(
            [sys.argv[0], "_dispatch", uuid],
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            start_new_session=True,
            close_fds=True)
    except OSError:
        pass
    finally:
        if log is not subprocess.DEVNULL:
            log.close()


def cmd_add(args):
    parsed, code = parse_add(args)
    if code:
        return code
    agent_query, text, file_path, wait, timeout, quiet, use_stdin = parsed
    resolved = resolve_agent(agent_query, allow_orphan=False)
    if resolved is None:
        return LAST_RESOLVE_RC
    uuid, name = resolved
    home = queue_home()
    agent_dir = os.path.join(home, uuid)
    if not os.path.isdir(home):
        os.makedirs(home)
    ensure_agent_dirs(agent_dir)
    write_agent_name(agent_dir, uuid, name)

    stage_path = os.path.join(agent_dir, "tmp", "stage.%d" % os.getpid())
    try:
        if file_path is not None:
            with open(file_path, "rb") as source:
                data = source.read()
        elif use_stdin:
            data = sys.stdin.buffer.read()
        else:
            data = text.encode("utf-8") + b"\n"
        with open(stage_path, "wb") as target:
            target.write(data)
    except (IOError, OSError, UnicodeError) as exc:
        try:
            os.unlink(stage_path)
        except OSError:
            pass
        return die("add: failed to stage message: %s" % exc)

    if not data or data.strip() == b"":
        try:
            os.unlink(stage_path)
        except OSError:
            pass
        return die("add: message is empty or whitespace-only")
    max_bytes = env_int("PASEO_QUEUE_MAX_BYTES", 262144)
    if len(data) > max_bytes:
        try:
            os.unlink(stage_path)
        except OSError:
            pass
        return die("add: message exceeds PASEO_QUEUE_MAX_BYTES (%d bytes); override via PASEO_QUEUE_MAX_BYTES"
                   % max_bytes)

    try:
        filename = next_msg_name(agent_dir)
        os.replace(stage_path, os.path.join(agent_dir, "pending", filename))
        log_line(agent_dir, "ENQ", "%s %s" % (uuid, filename))
        spawn_dispatcher(uuid)
    except (IOError, OSError, RuntimeError) as exc:
        try:
            os.unlink(stage_path)
        except OSError:
            pass
        return die("add: failed to enqueue message: %s" % exc)

    short_id = uuid[:7]
    if not quiet:
        sys.stdout.write("paseo-queue: enqueued %s pending/%s\n" % (short_id, filename))
        sys.stdout.flush()
    if wait:
        return wait_for_delivery(agent_dir, filename,
                                 int(timeout) if timeout is not None else None,
                                 quiet, short_id)
    return 0


def cmd_rm(args):
    if len(args) < 2:
        return die("rm: usage: paseo-queue rm <agent> <msg|--all>")
    query, target = args[0], args[1]
    resolved = resolve_agent(query, allow_orphan=True)
    if resolved is None:
        # Propagate the REASON. LAST_RESOLVE_RC is EXIT_DAEMON when the
        # snapshot fetch itself failed, so a daemon outage is not reported as
        # "no such agent". The sh version exits 3 here, and a caller uses the
        # 3-versus-2 distinction to decide between retrying and giving up.
        return die("rm: unable to resolve agent: %s" % query, LAST_RESOLVE_RC)
    uuid, unused_name = resolved
    agent_dir = os.path.join(queue_home(), uuid)
    if not os.path.isdir(agent_dir):
        return die("rm: no queue state for %s" % query)
    short_id = uuid[:7]

    if target == "--all":
        removed = 0
        for path in message_files(os.path.join(agent_dir, "pending")):
            filename = os.path.basename(path)
            sys.stdout.write("paseo-queue: removed %s pending/%s\n" % (short_id, filename))
            os.unlink(path)
            removed += 1
        sys.stdout.write("paseo-queue: removed %d pending message(s) for %s\n"
                         % (removed, short_id))
        log_line(agent_dir, "CANCEL", "%s --all (%d removed)" % (uuid, removed))

        # Do the daemon-known check first. Only an already-orphaned queue may
        # have its stale lock reclaimed by this local cleanup path.
        if not agent_is_known(uuid):
            remove_stale_lock(agent_dir)
            if queue_dir_is_empty(agent_dir):
                shutil.rmtree(agent_dir)
        return 0

    if "/" in target or os.path.sep in target:
        return die("rm: invalid message name (must be a bare filename, no path separators): %s"
                   % target)
    path = os.path.join(agent_dir, "pending", target)
    if not os.path.exists(path):
        return die("rm: no such pending message: %s" % target)
    try:
        os.unlink(path)
    except OSError as exc:
        return die("rm: failed to remove %s: %s" % (target, exc))
    sys.stdout.write("paseo-queue: removed %s pending/%s\n" % (short_id, target))
    log_line(agent_dir, "CANCEL", "%s %s" % (uuid, target))
    return 0




def cmd_dispatch(args):
    if not args:
        return die("_dispatch: usage: paseo-queue _dispatch <uuid>")
    uuid = args[0]
    agent_dir = os.path.join(queue_home(), uuid)
    if not os.path.isdir(queue_home()):
        os.makedirs(queue_home())
    ensure_agent_dirs(agent_dir)

    was_stale = dp_lock_is_stale(agent_dir)
    old_int = signal.getsignal(signal.SIGINT)
    old_term = signal.getsignal(signal.SIGTERM)
    stderr_path = os.path.join(agent_dir, "tmp", "stderr.%d" % os.getpid())

    def cleanup_on_signal(signum, unused_frame):
        signal.signal(signal.SIGINT, signal.SIG_DFL)
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        release_lock(agent_dir)
        set_state(agent_dir, "stopped")
        log_line(agent_dir, "EXIT", "reason=signal sig=%s" %
                 ("INT" if signum == signal.SIGINT else "TERM"))
        try:
            os.unlink(stderr_path)
        except OSError:
            pass
        raise SystemExit(130 if signum == signal.SIGINT else 143)

    signal.signal(signal.SIGINT, cleanup_on_signal)
    signal.signal(signal.SIGTERM, cleanup_on_signal)

    if not acquire_lock(agent_dir):
        signal.signal(signal.SIGINT, old_int)
        signal.signal(signal.SIGTERM, old_term)
        holder = "none"
        pid_path = os.path.join(agent_dir, "lock", "pid")
        try:
            with open(pid_path, "r") as stream:
                holder = stream.read().strip()
        except (IOError, OSError):
            pass
        log_line(agent_dir, "SKIP", "%s lock held by live dispatcher pid=%s" %
                 (uuid, holder))
        return 0

    if was_stale:
        log_line(agent_dir, "STEAL", "%s stale lock cleared" % uuid)
    set_state(agent_dir, "running")
    log_line(agent_dir, "START", "%s pid=%s" % (uuid, os.getpid()))

    daemon_fail_count = 0
    send_fail_count = 0
    send_fail_msg = ""
    hold_backoff_count = 0
    hold_last_log = 0
    busy_last_log = 0

    while True:
        pending = message_files(os.path.join(agent_dir, "pending"))
        if not pending:
            log_line(agent_dir, "LINGER", "pending=0")
            set_state(agent_dir, "idle-drain")
            lingered = 0
            while True:
                pending = message_files(os.path.join(agent_dir, "pending"))
                if pending:
                    break
                if lingered >= env_int("PASEO_QUEUE_LINGER", 10):
                    break
                time.sleep(1)
                lingered += 1
            if pending:
                continue

            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            release_lock(agent_dir)
            if message_files(os.path.join(agent_dir, "pending")):
                if acquire_lock(agent_dir):
                    log_line(agent_dir, "REACQUIRE",
                             "pending work found post-release")
                    signal.signal(signal.SIGINT, cleanup_on_signal)
                    signal.signal(signal.SIGTERM, cleanup_on_signal)
                    continue
                log_line(agent_dir, "YIELD",
                         "lock taken by another dispatcher after release")
                return 0
            set_state(agent_dir, "stopped")
            log_line(agent_dir, "EXIT", "reason=empty")
            return 0

        path = pending[0]
        filename = os.path.basename(path)
        if filename != send_fail_msg:
            send_fail_count = 0
            send_fail_msg = filename

        dispatch = inspect_dispatch(uuid)
        if dispatch is None:
            daemon_fail_count += 1
            set_state(agent_dir, "daemon-retry")
            if daemon_fail_count >= env_int("PASEO_QUEUE_DAEMON_RETRIES", 15):
                log_line(agent_dir, "FATAL",
                         "reason=daemon-unreachable pending=%d" % len(pending))
                set_state(agent_dir, "stalled-daemon")
                signal.signal(signal.SIGINT, signal.SIG_DFL)
                signal.signal(signal.SIGTERM, signal.SIG_DFL)
                release_lock(agent_dir)
                return 1
            sleep_backoff(scale_backoff(daemon_backoff(daemon_fail_count)))
            continue

        daemon_fail_count = 0
        status, archived, permissions = dispatch
        if status in ("closed", "unknown") or archived:
            log_line(agent_dir, "HALT",
                     "reason=closed pending=%d" % len(pending))
            set_state(agent_dir, "halted-closed")
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            release_lock(agent_dir)
            return 0

        if permissions > 0:
            set_state(agent_dir, "holding-permission")
            now = int(time.time())
            if now - hold_last_log >= env_int("PASEO_QUEUE_HOLD_LOG_EVERY", 300):
                log_line(agent_dir, "HOLD-PERM",
                         "n=%d msg=%s" % (permissions, filename))
                hold_last_log = now
            subprocess.call(
                ["paseo", "wait", uuid, "--timeout",
                 str(env_int("PASEO_QUEUE_WAIT_TIMEOUT", 60)), "--json"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            hold_backoff_count += 1
            sleep_backoff(scale_backoff(hold_backoff(hold_backoff_count)))
            continue
        hold_backoff_count = 0

        if status == "running":
            set_state(agent_dir, "waiting")
            now = int(time.time())
            if now - busy_last_log >= env_int("PASEO_QUEUE_HOLD_LOG_EVERY", 300):
                log_line(agent_dir, "WAIT-BUSY", "msg=%s" % filename)
                busy_last_log = now
            subprocess.call(
                ["paseo", "wait", uuid, "--timeout",
                 str(env_int("PASEO_QUEUE_WAIT_TIMEOUT", 60)), "--json"],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            continue

        if not os.path.exists(path):
            log_line(agent_dir, "CANCEL", "%s removed before send" % filename)
            continue

        set_state(agent_dir, "sending")
        log_line(agent_dir, "SEND-BEGIN", filename)
        try:
            with open(stderr_path, "wb") as stderr_stream:
                send_rc = subprocess.call(
                    ["paseo", "send", uuid, "--prompt-file", path],
                    stdout=subprocess.DEVNULL, stderr=stderr_stream)
        except (IOError, OSError):
            send_rc = 1

        if send_rc == 0:
            try:
                byte_count = os.path.getsize(path)
                os.replace(path, os.path.join(agent_dir, "sent", filename))
            except OSError as exc:
                signal.signal(signal.SIGINT, signal.SIG_DFL)
                signal.signal(signal.SIGTERM, signal.SIG_DFL)
                release_lock(agent_dir)
                log_line(agent_dir, "SEND-FAIL",
                         "msg=%s error=%s" % (filename, exc))
                set_state(agent_dir, "stopped")
                log_line(agent_dir, "EXIT", "reason=move-failed")
                return 1
            log_line(agent_dir, "SEND-OK", "msg=%s bytes=%s" %
                     (filename, byte_count))
            send_fail_count = 0
            daemon_fail_count = 0
            try:
                os.unlink(stderr_path)
            except OSError:
                pass
            continue

        dispatch_after_failure = inspect_dispatch(uuid)
        if dispatch_after_failure is None:
            log_line(agent_dir, "SEND-FAIL",
                     "msg=%s rc=%s reason=daemon" % (filename, send_rc))
            daemon_fail_count += 1
            set_state(agent_dir, "daemon-retry")
            if daemon_fail_count >= env_int("PASEO_QUEUE_DAEMON_RETRIES", 15):
                log_line(agent_dir, "FATAL",
                         "reason=daemon-unreachable pending=%d" % len(pending))
                set_state(agent_dir, "stalled-daemon")
                signal.signal(signal.SIGINT, signal.SIG_DFL)
                signal.signal(signal.SIGTERM, signal.SIG_DFL)
                release_lock(agent_dir)
                return 1
            sleep_backoff(scale_backoff(daemon_backoff(daemon_fail_count)))
            continue

        after_status, after_archived, unused_permissions = dispatch_after_failure
        if (after_status in ("closed", "unknown") or after_archived):
            log_line(agent_dir, "SEND-FAIL",
                     "msg=%s rc=%s reason=closed" % (filename, send_rc))
            log_line(agent_dir, "HALT",
                     "reason=closed pending=%d" % len(pending))
            set_state(agent_dir, "halted-closed")
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            release_lock(agent_dir)
            return 0

        send_fail_count += 1
        log_line(agent_dir, "SEND-FAIL",
                 "msg=%s rc=%s" % (filename, send_rc))
        if send_fail_count >= env_int("PASEO_QUEUE_SEND_RETRIES", 5):
            write_send_error(agent_dir, filename, send_rc, stderr_path)
            try:
                os.replace(path, os.path.join(agent_dir, "failed", filename))
            except OSError:
                pass
            log_line(agent_dir, "MOVE-FAILED", "msg=%s" % filename)
            log_line(agent_dir, "FATAL",
                     "reason=message-failed msg=%s" % filename)
            set_state(agent_dir, "halted-failed")
            signal.signal(signal.SIGINT, signal.SIG_DFL)
            signal.signal(signal.SIGTERM, signal.SIG_DFL)
            release_lock(agent_dir)
            return 1

        log_line(agent_dir, "RETRY",
                 "attempt=%d/%d msg=%s" %
                 (send_fail_count,
                  env_int("PASEO_QUEUE_SEND_RETRIES", 5), filename))
        sleep_backoff(scale_backoff(send_backoff(send_fail_count)))

def dispatcher_alive(agent_dir):
    lock_dir = os.path.join(agent_dir, "lock")
    if not os.path.isdir(lock_dir):
        return False, "none"
    pid_path = os.path.join(lock_dir, "pid")
    if os.path.isfile(pid_path):
        try:
            with open(pid_path, "r") as stream:
                pid = int(stream.read().strip())
        except (IOError, OSError, TypeError, ValueError):
            return False, "none"
        return lock_holder_alive(agent_dir), str(pid)
    return lock_holder_alive(agent_dir), "none"


def cmd_status(args):
    if fetch_ls_json() != 0:
        sys.stderr.write(
            "paseo-queue: status: paseo ls --json failed (daemon unreachable?)\n")
        return EXIT_DAEMON
    home = queue_home()
    if not os.path.isdir(home):
        return 0
    live_names = {}
    for row in snapshot_agents():
        uuid = row.get("id", "")
        if isinstance(uuid, str) and isinstance(row.get("name", ""), str):
            live_names[uuid] = row.get("name", "")
    try:
        entries = sorted(os.listdir(home))
    except (IOError, OSError):
        return 0
    for entry in entries:
        agent_dir = os.path.join(home, entry)
        if not os.path.isdir(agent_dir):
            continue
        name = live_names.get(entry, agent_name(agent_dir))
        orphan_tag = "" if entry in live_names else " ORPHANED"
        # status holds live names for EVERY known agent, not just one, so it
        # is the cheapest place to converge the whole set: one `status` run
        # refreshes every stale display name that `ls` would otherwise show.
        if entry in live_names:
            refresh_agent_name(agent_dir, entry, name)
        state = "unknown"
        state_path = os.path.join(agent_dir, "state")
        if os.path.isfile(state_path):
            try:
                with open(state_path, "r") as stream:
                    state = stream.read().rstrip("\n")
            except (IOError, OSError):
                pass
        pending = len(message_files(os.path.join(agent_dir, "pending")))
        sent = len(message_files(os.path.join(agent_dir, "sent")))
        failed = len(message_files(os.path.join(agent_dir, "failed")))
        alive, pid = dispatcher_alive(agent_dir)
        sys.stdout.write(
            "%s %s%s: state=%s pending=%d sent=%d failed=%d dispatcher=%s(pid=%s)\n"
            % (entry, name, orphan_tag, state, pending, sent, failed,
               "up" if alive else "down", pid))
        if pending and not alive:
            sys.stderr.write(
                "paseo-queue: WARN: %s has pending messages but no live "
                "dispatcher; run: paseo-queue drain %s\n" % (entry, entry))
        if state == "holding-permission":
            sys.stderr.write(
                "paseo-queue: WARN: %s dispatcher is holding-permission "
                "(needs human attention)\n" % entry)
    return 0


def split_quiet(args):
    """Pull a --quiet flag out of argv, returning (remaining, quiet)."""
    remaining = []
    quiet = False
    for token in args:
        if token == "--quiet":
            quiet = True
        else:
            remaining.append(token)
    return remaining, quiet


def lock_holder_pid(agent_dir):
    """The pid recorded in lock/pid, as a string, or "" if unreadable."""
    try:
        with open(os.path.join(agent_dir, "lock", "pid"), "r") as stream:
            return stream.read().strip()
    except (IOError, OSError):
        return ""


def cmd_drain(args):
    args, quiet = split_quiet(args)
    if not args:
        return die("drain: usage: paseo-queue drain <agent> [--quiet]")
    if len(args) > 1:
        return die("drain: unknown option: %s" % args[1])
    resolved = resolve_agent(args[0], allow_orphan=False)
    if resolved is None:
        return LAST_RESOLVE_RC
    uuid, unused_name = resolved
    agent_dir = os.path.join(queue_home(), uuid)
    ensure_agent_dirs(agent_dir)

    # Observe BEFORE spawning so the receipt can say which of the two things
    # happened. The spawn itself stays UNCONDITIONAL: it is what closes the
    # enqueue-versus-exiting-dispatcher race, and a redundant dispatcher exits
    # immediately logging SKIP. So this observation is a report, never a
    # decision -- do not turn it into an early return.
    already = lock_holder_alive(agent_dir)
    holder = lock_holder_pid(agent_dir) if already else ""

    spawn_dispatcher(uuid)

    # `status` tells callers to run drain when it warns about pending messages
    # with no live dispatcher. Following that advice used to print nothing at
    # all, so the caller could not distinguish the remedy working from a no-op
    # or from a failure to resolve (issue #10).
    if not quiet:
        if already and holder:
            sys.stdout.write("paseo-queue: drained %s (dispatcher already "
                             "live, pid=%s)\n" % (uuid[:7], holder))
        elif already:
            sys.stdout.write("paseo-queue: drained %s (dispatcher already "
                             "live)\n" % uuid[:7])
        else:
            sys.stdout.write("paseo-queue: drained %s (spawned a "
                             "dispatcher)\n" % uuid[:7])
    return 0


def cmd_stop(args):
    args, quiet = split_quiet(args)
    if not args:
        return die("stop: usage: paseo-queue stop <agent> [--quiet]")
    if len(args) > 1:
        return die("stop: unknown option: %s" % args[1])
    resolved = resolve_agent(args[0], allow_orphan=True)
    if resolved is None:
        return LAST_RESOLVE_RC
    uuid, unused_name = resolved
    agent_dir = os.path.join(queue_home(), uuid)
    if not os.path.isdir(agent_dir):
        return die("stop: no queue state for %s" % args[0])
    pid_path = os.path.join(agent_dir, "lock", "pid")
    if os.path.isfile(pid_path) and lock_holder_alive(agent_dir):
        try:
            with open(pid_path, "r") as stream:
                pid = int(stream.read().strip())
            os.kill(pid, signal.SIGTERM)
        except (IOError, OSError, TypeError, ValueError):
            pass
        else:
            log_line(agent_dir, "STOP", "%s pid=%s" % (uuid, pid))
            # The consequential branch: a live process was just terminated.
            # It used to be the SILENT one, while the harmless no-op below was
            # loud and non-zero -- exactly backwards (issue #10).
            if not quiet:
                sys.stdout.write("paseo-queue: stopped %s dispatcher pid=%s\n"
                                 % (uuid[:7], pid))
            return 0

    # Nothing was running. This is SUCCESS, not failure: the caller asked for
    # the dispatcher to be stopped and it is stopped. Exiting non-zero here
    # made `stop X && next` fail precisely when X was already in the desired
    # state, so stop could not be used as an ensure-stopped step. Callers that
    # need to distinguish "terminated something" from "already stopped" read
    # the receipt on stdout, which says which happened -- more explicitly than
    # an exit code could.
    if not quiet:
        sys.stdout.write("paseo-queue: stopped %s (no live dispatcher; "
                         "already stopped)\n" % uuid[:7])
    return 0


def cmd_ls(args):
    if args:
        return die("ls: unknown option: %s" % args[0])
    home = queue_home()
    if not os.path.isdir(home):
        return 0
    try:
        entries = sorted(os.listdir(home))
    except (IOError, OSError):
        return 0
    for entry in entries:
        agent_dir = os.path.join(home, entry)
        if not os.path.isdir(agent_dir):
            continue
        pending = message_files(os.path.join(agent_dir, "pending"))
        sent = message_files(os.path.join(agent_dir, "sent"))
        failed = message_files(os.path.join(agent_dir, "failed"))
        sys.stdout.write("%s %s: pending=%d sent=%d failed=%d\n" % (entry, agent_name(agent_dir), len(pending), len(sent), len(failed)))
        for path in pending:
            sys.stdout.write("  pending/%s\n" % os.path.basename(path))
    return 0


def cmd_log(args):
    if not args:
        return die("log: usage: paseo-queue log <agent> [-n N] [-f]")
    query = args[0]
    rest = list(args[1:])
    count = 20
    follow = False
    index = 0
    while index < len(rest):
        option = rest[index]
        index += 1
        if option == "-n":
            if index >= len(rest):
                return die("log: -n requires a value")
            value = rest[index]
            index += 1
            if not value.isdigit():
                return die("log: -n requires a nonnegative integer")
            count = int(value)
        elif option == "-f":
            follow = True
        else:
            return die("log: unknown option: %s" % option)
    resolved = resolve_agent(query, allow_orphan=True)
    if resolved is None:
        # Same reason-propagation as cmd_rm: a daemon outage must exit 3, not
        # 2, matching the sh version.
        return die("log: unable to resolve agent: %s" % query, LAST_RESOLVE_RC)
    uuid, unused_name = resolved
    log_path = os.path.join(queue_home(), uuid, "dispatch.log")
    if not os.path.isfile(log_path):
        return die("log: no log for %s" % query)
    try:
        with open(log_path, "r") as stream:
            lines = stream.readlines()
        if count:
            sys.stdout.write("".join(lines[-count:]))
        if follow:
            while True:
                time.sleep(1)
                with open(log_path, "r") as stream:
                    updated = stream.readlines()
                if len(updated) > len(lines):
                    sys.stdout.write("".join(updated[len(lines):]))
                    lines = updated
    except (IOError, OSError) as exc:
        return die("log: failed to read log: %s" % exc)
    return 0


def main(argv):
    if not argv:
        sys.stderr.write(USAGE)
        return EXIT_USAGE
    command = argv[0]
    args = argv[1:]
    if command in ("help", "--help", "-h"):
        sys.stdout.write(USAGE)
        return 0
    if command == "add":
        return cmd_add(args)
    if command == "ls":
        return cmd_ls(args)
    if command == "rm":
        return cmd_rm(args)
    if command == "log":
        return cmd_log(args)
    if command == "_dispatch":
        return cmd_dispatch(args)
    if command == "status":
        return cmd_status(args)
    if command == "drain":
        return cmd_drain(args)
    if command == "stop":
        return cmd_stop(args)
    sys.stderr.write(USAGE)
    return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
